# ---- Model server: any OpenAI-compatible endpoint ----
# Local Ollama (default)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=medgemma
LLM_API_KEY=

# Hugging Face Inference Endpoint (example)
# LLM_BASE_URL=https://<your-endpoint>.endpoints.huggingface.cloud/v1
# LLM_MODEL=tgi
# LLM_API_KEY=hf_xxx

DEFAULT_TEMPERATURE=0.4
DEFAULT_MAX_TOKENS=1024

# ---- API ----
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:5173,http://127.0.0.1:5173
# Set to require clients to send header X-API-Key
APP_API_KEY=

MAX_IMAGE_MB=10
MAX_IMAGES_PER_MESSAGE=4


# ---- PostgreSQL (minikube dev/postgres-postgresql via scripts/db-tunnel.sh on 15432) ----
DATABASE_URL=postgresql://smarter_health:<password>@localhost:15432/smarter_health
# Enables doctor admin endpoints (PUT/DELETE /api/doctors/{id}) via header X-Admin-Key
ADMIN_API_KEY=
