# Settings for `docker compose` (copy to .env). All values are optional.

# Password for the bundled PostgreSQL container (local use only — change it)
POSTGRES_PASSWORD=change-me-local-only

# Use an external PostgreSQL instead of the bundled one (e.g. minikube via port-forward):
# DATABASE_URL=postgresql://smarter_health:<password>@host.docker.internal:15432/smarter_health

# Model server (any OpenAI-compatible endpoint). Default: Ollama on your machine.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=medgemma
LLM_API_KEY=

# Origins allowed to call the API (the Next.js frontend)
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Optional keys: APP_API_KEY protects all routes, ADMIN_API_KEY enables doctor admin routes
APP_API_KEY=
ADMIN_API_KEY=

# Load 200 FICTIONAL sample doctors when the database is empty
SEED_SAMPLE_DOCTORS=true

# Host ports
API_PORT=8000
DB_PORT=5433
